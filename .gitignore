# .gitignore for predictive-maintenance (Python / ML / research project)

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs / editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# Editor swap / temp files
*~
*.swp
*.swo
*.bak

# Python
__pycache__/
*.py[cod]
*$py.class
.python-version

# Virtual environments
venv/
.env/
.venv/
env/
env.bak/
venv.bak/
__pypackages__/

# Packaging / distribution
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# PyInstaller
*.spec

# Testing / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints
*.nbconvert.ipynb

# Data, models, outputs (common directories - adjust names to your project)
data/
data_raw/
data_processed/
datasets/
models/
checkpoints/
outputs/
results/
predictions/

# Large or binary files often used in ML
*.csv
*.tsv
*.parquet
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.joblib
*.ckpt
*.pth
*.pt
*.tfrecord

# Logs and runtime files
logs/
*.log
*.out
*.pid

# Experiment tracking / ML tooling
wandb/
mlruns/
tensorboard/
runs/
tb_logs/

# DVC / cache
.dvc/
.dvcignore
.cache/
.cache/

# Databases
*.sqlite3
*.db
*.db-journal

# Secret / env files
.env
.env.*
secrets.json
credentials.json

# Docker / compose
docker-compose.override.yml
docker-compose.*.yml
*.envrc

# Misc
*.zip
*.tar
*.gz
*.egg